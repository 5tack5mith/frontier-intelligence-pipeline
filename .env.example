# LLM providers — fallback chain order: Gemini -> Groq -> DeepSeek
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# GitHub — used for star-count enrichment of research papers.
# Generate a fine-grained personal access token with NO special scopes
# needed (public repo read only). Without this, GitHub calls fall back
# to 60 req/hr unauthenticated instead of 5,000 req/hr.
GITHUB_TOKEN=your-github-token-here

# Google Sheets output (only needed if using output/to_sheets.py instead
# of the CSV fallback). Requires a service account JSON key file — see
# https://docs.gspread.org/en/latest/oauth2.html
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./service_account.json
GOOGLE_SHEET_ID=
